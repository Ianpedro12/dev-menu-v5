local partesEspObjetos = {}

local function limparESPPartes()
    for _, item in ipairs(partesEspObjetos) do
        if item.Highlight then item.Highlight:Destroy() end
        if item.Billboard then item.Billboard:Destroy() end
    end
    partesEspObjetos = {}
    espPStatus.Text = "Status: ESPs limpos com sucesso!"
    espPStatus.TextColor3 = Color3.fromRGB(255, 200, 0)
end

local function buscarEAtivarESPPartes(palavraChave)
    limparESPPartes()

    if palavraChave == "" then
        espPStatus.Text = "Digite uma palavra-chave válida!"
        espPStatus.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end

    local termo = string.lower(palavraChave)
    local encontrados = 0

    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("BasePart") or obj:IsA("Model")) and string.find(string.lower(obj.Name), termo) then
            encontrados = encontrados + 1

            local highlight = Instance.new("Highlight")
            highlight.Name = "ESP_Parte_Highlight"
            highlight.Adornee = obj
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
