    if nomeParte == "" then
        tpNPStatus.Text = "Digite um nome válido!"
        tpNPStatus.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local parteEncontrada = workspace:FindFirstChild(nomeParte, true)

    if parteEncontrada and parteEncontrada:IsA("BasePart") then
        hrp.CFrame = parteEncontrada.CFrame + Vector3.new(0, 3, 0)
        tpNPStatus.Text = "Teleportado para: " .. parteEncontrada.Name
        tpNPStatus.TextColor3 = Color3.fromRGB(0, 255, 200)
    else
        tpNPStatus.Text = "Parte não encontrada!"
        tpNPStatus.TextColor3 = Color3.fromRGB(255, 100, 100)
    end
end

