local touchStartPos = nil

UserInputService.InputBegan:Connect(function(input, gpe)
    if freecamAtivo and not gpe then
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            touchStartPos = input.Position
        end
    end
end)

UserInputService.InputChanged:Connect(function(input, gpe)
    if freecamAtivo and touchStartPos then
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - touchStartPos
            touchStartPos = input.Position
            rotY = rotY - delta.X * 0.004
            rotX = math.clamp(rotX - delta.Y * 0.004, math.rad(-85), math.rad(85))
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        touchStartPos = nil
    end
end)

local function alternarFreecam()
    freecamAtivo = not freecamAtivo

    if freecamAtivo then
        btnFreecam.Text = "Freecam (Câmera Livre): ON"
        btnFreecam.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
        freecamTouchPad.Visible = true

        local currentCF = Camera.CFrame
        freecamCF = currentCF
        local rx, ry, _ = currentCF:ToOrientation()
        rotX = rx
        rotY = ry

        Camera.CameraType = Enum.CameraType.Scriptable

        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = 0
            hum.JumpPower = 0
        end

        freecamConnection = RunService.RenderStepped:Connect(function()
            local kbDir = Vector3.new(0, 0, 0)
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then kbDir = kbDir + Vector3.new(0, 0, -1) end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then kbDir = kbDir + Vector3.new(0, 0, 1) end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then kbDir = kbDir + Vector3.new(-1, 0, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then kbDir = kbDir + Vector3.new(1, 0, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.E) then kbDir = kbDir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.Q) then kbDir = kbDir + Vector3.new(0, -1, 0) end

            local totalDir = moveDir + kbDir
            local rotCFrame = CFrame.Angles(0, rotY, 0) * CFrame.Angles(rotX, 0, 0)
            
            local moveVector = rotCFrame:VectorToWorldSpace(totalDir) * freecamSpeed
            freecamCF = CFrame.new(freecamCF.Position + moveVector) * rotCFrame

            Camera.CFrame = freecamCF
        end)
    else
        btnFreecam.Text = "Freecam (Câmera Livre): OFF"
        btnFreecam.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        freecamTouchPad.Visible = false

        if freecamConnection then
            freecamConnection:Disconnect()
            freecamConnection = nil
        end

        Camera.CameraType = Enum.CameraType.Custom
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            Camera.CameraSubject = hum
            hum.WalkSpeed = 16
            hum.JumpPower = 50
        end
    end
end

