local function desenharLinha(p1, p2)
    local distancia = (p1 - p2).Magnitude
    local centro = (p1 + p2) / 2
    local angulo = math.atan2(p2.Y - p1.Y, p2.X - p1.X)

    tracerFrame.Size = UDim2.new(0, distancia, 0, 2)
    tracerFrame.Position = UDim2.new(0, centro.X, 0, centro.Y)
    tracerFrame.Rotation = math.deg(angulo)
    tracerFrame.Visible = true
end

