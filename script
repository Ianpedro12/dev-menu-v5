RunService.RenderStepped:Connect(function()
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local closestPlayer, closestDist = obterJogadorMaisProximo()

    if closestPlayer then
        hudMaisProximo.Text = string.format("%s\n[%dm]", closestPlayer.DisplayName, math.floor(closestDist))
    else
        hudMaisProximo.Text = "Mais Próximo: Nenhum"
    end

    if not freecamAtivo then
        -- LÓGICA DO AIMBOT MELHORADO (SUAVE / HOLD)
        if segurandoMiraMelhorada and closestPlayer and closestPlayer.Character then
            local head = closestPlayer.Character:FindFirstChild("Head")
            local hum = closestPlayer.Character:FindFirstChildOfClass("Humanoid")
            if head and hum and hum.Health > 0 then
                local targetCFrame = CFrame.new(Camera.CFrame.Position, head.Position)
                -- Transição suave da câmera usando Lerp (fator 0.20 para transição fluida)
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 0.20)
            end

        -- DEMAIS MODOS DE AIMBOT
        elseif aimEspecificoAtivo and targetAimEspecifico then
            if targetAimEspecifico.Parent and targetAimEspecifico.Character then
                local head = targetAimEspecifico.Character:FindFirstChild("Head")
                local hum = targetAimEspecifico.Character:FindFirstChildOfClass("Humanoid")
                if head and hum and hum.Health > 0 then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, head.Position)
                end
            end
        elseif aimAtivo then
            local targetPlayer = nil
            if aimModo == "Descarado" then
                targetPlayer = closestPlayer
            elseif aimModo == "Disfarcado" then
                if targetDisfarcado and targetDisfarcado.Parent and targetDisfarcado.Character then
                    local hum = targetDisfarcado.Character:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        targetPlayer = targetDisfarcado
                    else
                        targetDisfarcado = nil
                    end
                else
                    targetDisfarcado = nil
                end
            end

            if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("Head") then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPlayer.Character.Head.Position)
            end
        end
    end

    if spEspecificoAtivo then
        for player, _ in pairs(espObjects) do
            if player ~= targetSPEspecifico then
                limparESPJogador(player)
            end
        end

        if targetSPEspecifico and targetSPEspecifico.Character then
            local char = targetSPEspecifico.Character
            local hum = char:FindFirstChildOfClass("Humanoid")
            local targetHrp = char:FindFirstChild("HumanoidRootPart")
            
            if hum and hum.Health > 0 and targetHrp then
                if not espObjects[targetSPEspecifico] or not espObjects[targetSPEspecifico].Highlight or espObjects[targetSPEspecifico].Highlight.Parent ~= char then
                    criarESPJogador(targetSPEspecifico)
                end

                local data = espObjects[targetSPEspecifico]
                if data and myHrp then
                    local dist = (myHrp.Position - targetHrp.Position).Magnitude
                    data.Label.Text = string.format("%s\n[%dm]", targetSPEspecifico.DisplayName, math.floor(dist))
                    data.Highlight.FillColor = Color3.fromRGB(255, 255, 0)
                    data.Label.TextColor3 = Color3.fromRGB(255, 255, 0)
                end

                local head = char:FindFirstChild("Head")
                if head then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local centroInferior = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        desenharLinha(centroInferior, Vector2.new(screenPos.X, screenPos.Y))
                    else
                        tracerFrame.Visible = false
                    end
                end
            else
                limparESPJogador(targetSPEspecifico)
                tracerFrame.Visible = false
            end
        else
            tracerFrame.Visible = false
        end

    elseif espDistanciaAtivo then
        for _, player in ipairs(Players:GetPlayers()) do
            if ehInimigo(player) then
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Head") and myHrp then
                    local dist = (myHrp.Position - char.HumanoidRootPart.Position).Magnitude
                    local hum = char:FindFirstChildOfClass("Humanoid")

                    if dist <= maxMetrosESP and hum and hum.Health > 0 then
                        if not espObjects[player] or not espObjects[player].Highlight or espObjects[player].Highlight.Parent ~= char then
                            criarESPJogador(player)
                        end
                    else
                        limparESPJogador(player)
                    end
                else
                    limparESPJogador(player)
                end
            else
                limparESPJogador(player)
            end
        end

        for player, data in pairs(espObjects) do
            if player.Parent and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local targetHrp = player.Character.HumanoidRootPart
                local eMaisProximo = (player == closestPlayer)
                local corUsar = eMaisProximo and Color3.fromRGB(0, 255, 255) or obterCorJogador(player)

                data.Highlight.FillColor = corUsar
                data.Label.TextColor3 = corUsar
                if myHrp then
                    local dist = (myHrp.Position - targetHrp.Position).Magnitude
                    data.Label.Text = string.format("%s\n[%dm]", player.DisplayName, math.floor(dist))
                end
            else
                limparESPJogador(player)
            end
        end

    elseif espAtivo then
        for _, player in ipairs(Players:GetPlayers()) do
            if ehInimigo(player) then
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Head") then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        if not espObjects[player] or not espObjects[player].Highlight or espObjects[player].Highlight.Parent ~= char then
                            criarESPJogador(player)
                        end
                    else
                        limparESPJogador(player)
                    end
                else
                    limparESPJogador(player)
                end
            else
                limparESPJogador(player)
            end
        end

        for player, data in pairs(espObjects) do
            if player.Parent and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local targetHrp = player.Character.HumanoidRootPart
                local eMaisProximo = (player == closestPlayer)
                local corUsar = eMaisProximo and Color3.fromRGB(0, 255, 255) or obterCorJogador(player)

                data.Highlight.FillColor = corUsar
                data.Label.TextColor3 = corUsar
                if myHrp then
                    local dist = (myHrp.Position - targetHrp.Position).Magnitude
                    data.Label.Text = string.format("%s\n[%dm]", player.DisplayName, math.floor(dist))
                end
            else
                limparESPJogador(player)
            end
        end
    end
end)
