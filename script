local function criarNovaParteInstancia(cframePosicao)
    contadorPartes = contadorPartes + 1
    local nomeParte = "parte " .. contadorPartes

    local novaParte = Instance.new("Part")
    novaParte.Name = nomeParte
    novaParte.Size = Vector3.new(4, 1, 4)
    novaParte.CFrame = cframePosicao
    novaParte.Anchored = true
    novaParte.CanCollide = false
    novaParte.Material = Enum.Material.Neon
    novaParte.Color = Color3.fromRGB(0, 255, 200)
    novaParte.Transparency = 0.4
    novaParte.Parent = workspace

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 100, 0, 20)
    bb.StudsOffset = Vector3.new(0, 2, 0)
    bb.AlwaysOnTop = true

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Text = nomeParte
    txt.TextColor3 = Color3.fromRGB(0, 255, 200)
    txt.TextSize = 12
    txt.Font = Enum.Font.SourceSansBold
    txt.Parent = bb
    bb.Parent = novaParte

    partesCriadas[contadorPartes] = {
        Nome = nomeParte,
        Instance = novaParte
    }

    if gerenciadorAtivo then atualizarListaGerenciarPartes() end
    if tpPartesAtivo then atualizarListaTPPartes() end
end

