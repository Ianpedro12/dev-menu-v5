local pages = {}

local function criarPagina(nome)
    local p = Instance.new("Frame")
    p.Name = nome
    p.Size = UDim2.new(1, 0, 1, 0)
    p.BackgroundTransparency = 1
    p.Visible = false
    p.Parent = content

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = p

    pages[nome] = p
    return p
end

local function mostrarPagina(nome)
    for pName, pageObj in pairs(pages) do
        pageObj.Visible = (pName == nome)
    end
end

local function criarBotao(pagina, texto, cor, ordem)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 30)
    btn.BackgroundColor3 = cor
    btn.Text = texto
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.Font = Enum.Font.SourceSansBold
    btn.LayoutOrder = ordem
    btn.Parent = pages[pagina]

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn
    
    return btn
end

