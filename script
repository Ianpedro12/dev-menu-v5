local aimAtivo = false
local aimModo = "Descarado"
local targetDisfarcado = nil

local function obterJogadorMaisProximo()
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil, math.huge end

    local menorDistancia = math.huge
    local jogadorMaisProximo = nil

    for _, player in ipairs(Players:GetPlayers()) do
        if ehInimigo(player) and player.Character then
            local targetHrp = player.Character:FindFirstChild("HumanoidRootPart")
            local targetHum = player.Character:FindFirstChildOfClass("Humanoid")
            
            if targetHrp and targetHum and targetHum.Health > 0 then
                local dist = (myHrp.Position - targetHrp.Position).Magnitude
                if dist < menorDistancia then
                    menorDistancia = dist
                    jogadorMaisProximo = player
                end
            end
        end
    end

    return jogadorMaisProximo, menorDistancia
end

